{
  "name": "pioneerhub-lithuania",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "lint": "node --check app/app.js && node --check src/worker.js",
    "typecheck": "node --check app/tests/smoke.test.mjs",
    "secrets:scan": "node scripts/secret-scan.mjs",
    "test": "node app/tests/smoke.test.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "verify:app-radar": "node scripts/verify-app-radar.mjs",
    "build": "npm run lint && npm run typecheck && npm run secrets:scan && npm test",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "validate:worker": "node scripts/validate-worker.mjs",
    "validate:pi-boundary": "node scripts/validate-pi-boundary.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.123.0"
  }
}
