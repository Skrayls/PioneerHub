{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "832c724c6353404b1c27d11db226d704",
  "name": "pioneerhub",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "./app", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "durable_objects": { "bindings": [{ "name": "PAYMENT_LEDGER", "class_name": "PaymentLedger" }, { "name": "AUTH_SESSIONS", "class_name": "AuthSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PaymentLedger"] }, { "tag": "v2", "new_sqlite_classes": ["AuthSession"] }],
  "vars": { "APP_ENV": "production", "PI_NETWORK": "testnet", "RELEASE_ID": "2026-08-19-community-signals-v1" },
  "env": { "staging": { "name": "pioneerhub-staging", "workers_dev": true, "vars": { "APP_ENV": "staging", "PI_NETWORK": "testnet" }, "observability": { "enabled": true, "head_sampling_rate": 1 } } }
}
